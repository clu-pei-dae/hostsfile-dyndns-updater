[Unit]
Description=DynDNS update endpoint for nginx (socket)
Documentation=https://github.com/clu-pei-dae/hostsfile-dyndns-updater

[Socket]
# Path is referenced by the nginx site. Only nginx (group www-data) may connect.
ListenStream=/run/hostsfile-dyndns-updater/api.sock
SocketUser=root
SocketGroup=www-data
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
