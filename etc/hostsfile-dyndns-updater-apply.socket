[Unit]
Description=hostsfile-dyndns-updater: writer for /etc/hosts (socket)
Documentation=https://github.com/clu-pei-dae/hostsfile-dyndns-updater

[Socket]
# Only the API service (group hostsfile-dyndns) may connect. Every connection
# starts one instance of hostsfile-dyndns-updater-apply@.service.
ListenStream=/run/hostsfile-dyndns-updater/apply.sock
Accept=yes
MaxConnections=8
SocketUser=root
SocketGroup=hostsfile-dyndns
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
