#!/bin/sh
set -e

user=hostsfile-dyndns
units="hostsfile-dyndns-updater.socket hostsfile-dyndns-updater-apply.socket hostsfile-dyndns-updater.service"

if [ "$1" = configure ]; then
    # The API service runs as this system user; only the helper that writes
    # /etc/hosts runs as root.
    if ! getent passwd "$user" >/dev/null; then
        adduser --system --group --no-create-home --home /nonexistent --quiet "$user"
    fi

    # The API reads the configuration through its group.
    chown root:"$user" /etc/hostsfile-dyndns-updater /etc/hostsfile-dyndns-updater/config.ini
    chmod 0750 /etc/hostsfile-dyndns-updater
    chmod 0640 /etc/hostsfile-dyndns-updater/config.ini

    # Request log: written by both parts. The directory stays root's, so the
    # unprivileged API cannot replace the file (e.g. by a symlink) that root
    # appends to. fail2ban refuses to start when a jail's log file is missing.
    install -d -m 0755 -o root -g root /var/log/hostsfile-dyndns-updater
    log=/var/log/hostsfile-dyndns-updater/requests.log
    [ -e "$log" ] || install -m 0660 /dev/null "$log"
    chown root:"$user" "$log"
    chmod 0660 "$log"

    # Enable the site on first install and after remove + reinstall, but not on
    # upgrades (an admin may have disabled it on purpose).
    site=/etc/nginx/sites-enabled/hostsfile-dyndns-updater
    marker=/var/lib/hostsfile-dyndns-updater/reenable-nginx-site
    if [ -d /etc/nginx/sites-enabled ] && [ ! -e "$site" ] && { [ -z "$2" ] || [ -e "$marker" ]; }; then
        ln -s ../sites-available/hostsfile-dyndns-updater "$site"
    fi
    rm -f "$marker"

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        # shellcheck disable=SC2086
        systemctl enable $units || true
        # Versions before 1.0 ran the whole backend as root with its own socket;
        # stop it so that the socket units can take over the paths.
        systemctl stop hostsfile-dyndns-updater.service || true
        systemctl restart hostsfile-dyndns-updater-apply.socket hostsfile-dyndns-updater.socket || true
        # Only start once at least one host is configured.
        if hostsfile-dyndns-updater check-config >/dev/null 2>&1; then
            systemctl start hostsfile-dyndns-updater.service || true
        else
            echo "hostsfile-dyndns-updater: not started, configure /etc/hostsfile-dyndns-updater/config.ini first." >&2
        fi
        if systemctl is-active --quiet nginx && nginx -t >/dev/null 2>&1; then
            systemctl reload nginx || true
        fi
        if systemctl is-active --quiet fail2ban; then
            if fail2ban-client -t >/dev/null 2>&1; then
                fail2ban-client reload >/dev/null || true
            else
                echo "hostsfile-dyndns-updater: fail2ban configuration test failed, not reloaded (run: fail2ban-client -t)." >&2
            fi
        fi
    fi
fi
exit 0
