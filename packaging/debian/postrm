#!/bin/sh
set -e
case "$1" in
    remove|purge)
        rm -rf /usr/lib/python3/dist-packages/hostsfile_dyndns_updater/__pycache__
        if [ -L /etc/nginx/sites-enabled/hostsfile-dyndns-updater ]; then
            rm -f /etc/nginx/sites-enabled/hostsfile-dyndns-updater
            # Reinstalling after "remove" should enable the site again.
            if [ "$1" = remove ]; then
                mkdir -p /var/lib/hostsfile-dyndns-updater
                touch /var/lib/hostsfile-dyndns-updater/reenable-nginx-site
            fi
        fi
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            if systemctl is-active --quiet nginx && nginx -t >/dev/null 2>&1; then
                systemctl reload nginx || true
            fi
        fi
        ;;
esac
if [ "$1" = purge ]; then
    rm -rf /etc/hostsfile-dyndns-updater /var/lib/hostsfile-dyndns-updater
    rm -f /var/log/nginx/hostsfile-dyndns-updater.access.log*
fi
exit 0
